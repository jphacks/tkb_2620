# Empty uses the same host through Vite's development proxy.
VITE_SOCKET_URL=
# Keep 3001 unless you also update the proxy in vite.config.ts.
PORT=3001
# Needed only for direct cross-origin connections; comma-separated origins.
CLIENT_ORIGIN=http://localhost:5173
# Supabase（#25 コースの保存・読み込み）。Project Settings → API の値を入れる。
# anon（public）キーはブラウザに公開される前提のキー。service_role キーは絶対に入れない。
# 空のままでも遊べる（保存・一覧が使えないだけ）。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
